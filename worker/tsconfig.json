{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@/*": ["../src/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "./**/*.ts",
    "../worker-configuration.d.ts",
    "../src/lib/game/types.ts",
    "../src/lib/game/rules.ts",
    "../src/lib/game/protocol.ts"
  ]
}
